# ==============================================================================
# Hasnain Personal Portfolio — Environment Configuration Template
# ==============================================================================
# SECURITY NOTICE:
# 1. Copy this file to `.env.local` for local development only when needed.
# 2. NEVER commit `.env` or `.env.local` or real credentials to version control.
# 3. Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser bundle.
#    Never place API keys, tokens, or secrets in `NEXT_PUBLIC_*` variables.
# ==============================================================================

# Public Site Metadata (Safe for browser exposure)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==============================================================================
# Gmail SMTP Configuration (Server-side only — set in Vercel Dashboard)
# Never prefix with NEXT_PUBLIC_
# ==============================================================================
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=

